# https://shop.m5stack.com/products/m5stamp-fly-with-m5stamps3

# GROVE EXPANSION
#
# The Stampfly has two Seeed Studio Grove connectors to attach peripherals. By
# default, the left (red) connector is I2C (with no other devices on the bus)
# and the right (black) connector is SERIAL3. However, the two signal pins in
# each can be reassigned by editing this file.
#
# Grove Red (I2C)
# 1 (toward front): GPIO_NUM_15, SCL (has 4.7kΩ pullup to 3.3V)
# 2               : GPIO_NUM_13, SDA (has 4.7kΩ pullup to 3.3V)
# 3               : +V (+5V if plugged into USB, else +Vbat)
# 4 (toward rear) : GND
#
# Grove Black (SERIAL3)
# 1 (toward rear) : GPIO_NUM_1, RX
# 2               : GPIO_NUM_2, TX
# 3               : +V (+5V if plugged into USB, else +Vbat)
# 4 (toward front): GND

# SPI Buses; https://docs.espressif.com/projects/esp-idf/en/v5.3.4/esp32/api-reference/peripherals/spi_master.html
#            Host      DMA Channel     MOSI        MISO        SCLK
ESP32_SPIBUS SPI2_HOST SPI_DMA_CH_AUTO GPIO_NUM_14 GPIO_NUM_43 GPIO_NUM_44

# the optical flow sensor (pixartflow) is on the same bus as the main IMU so
# a) we have to list it here so its CS gets deasserted and the IMU can talk, but
# b) we name it something the driver won't find because it's too slow and ties up the bus

# SPI Devices
#            Name                Bus   Device  ChipSel      Mode LoSpeed HiSpeed
ESP32_SPIDEV bmi270              0     0       GPIO_NUM_46  3    10*MHZ  10*MHZ
ESP32_SPIDEV pixartflow_disabled 0     1       GPIO_NUM_12  3     2*MHZ   2*MHZ

# i2c Buses
#             Port       SDA         SCL         SPEED    INTERNAL SOFT
ESP32_I2CBUS  I2C_NUM_0  GPIO_NUM_3  GPIO_NUM_4  400*KHZ  true     false
ESP32_I2CBUS  I2C_NUM_1  GPIO_NUM_13 GPIO_NUM_15 400*KHZ  false    false

# one IMU:
IMU BMI270 SPI:bmi270 ROTATION_ROLL_180_YAW_90
define INS_MAX_INSTANCES 1
define AP_INERTIALSENSOR_BATCHSAMPLER_ENABLED 0
define AP_INERTIALSENSOR_FAST_SAMPLE_WINDOW_ENABLED 0

# one compass:
COMPASS BMM150 I2C:0:0x10 false ROTATION_NONE
define AP_COMPASS_BMM150_ENABLED 1
define HAL_COMPASS_MAX_SENSORS 1
define AP_COMPASS_CALIBRATION_FIXED_YAW_ENABLED 0
define COMPASS_LEARN_ENABLED 0

# one Baro:
BARO BMP280 I2C:0:0x76
define AP_BARO_BACKEND_DEFAULT_ENABLED 0
define AP_BARO_BMP280_ENABLED 1
define AP_BARO_PROBE_EXTERNAL_I2C_BUSES 0
define HAL_BARO_WIND_COMP_ENABLED 0

# VL53L3CX XSHUT pins used by the original M5StampFly firmware.
# The VL53L3CX driver uses RNGFNDx_ORIENT only to select which
# same-address sensor is powered up on this board.
define AP_RANGEFINDER_BACKEND_DEFAULT_ENABLED 0
define AP_RANGEFINDER_VL53L3CX_ENABLED 1
define AP_OPTICALFLOW_ENABLED 1
define AP_OPTICALFLOW_BACKEND_DEFAULT_ENABLED 0
define AP_OPTICALFLOW_CALIBRATOR_ENABLED 0
define AP_OPTICALFLOW_CXOF_ENABLED 1
define AP_OPTICALFLOW_MAV_ENABLED 1
define AP_OPTICALFLOW_HEREFLOW_ENABLED 0
define HAL_MSP_OPTICALFLOW_ENABLED 0
define AP_OPTICALFLOW_ONBOARD_ENABLED 0
define AP_OPTICALFLOW_PIXART_ENABLED 0
define AP_OPTICALFLOW_PX4FLOW_ENABLED 0
define AP_OPTICALFLOW_SITL_ENABLED AP_SIM_ENABLED
define AP_OPTICALFLOW_UPFLOW_ENABLED 0

# M5StampFly build profile:
# The source list below intentionally includes only drivers used by onboard
# hardware or useful Grove expansion devices. If a feature needs more sources,
# add them here so the hwdef shows what is built for this board.
env AP_LIBRARY_SOURCES_ENABLED AC_InputManager:AC_InputManager.cpp AC_AttitudeControl:AC_AttitudeControl.cpp,AC_AttitudeControl_Logging.cpp,AC_AttitudeControl_Multi.cpp,AC_AttitudeControl_Multi_6DoF.cpp,AC_PosControl.cpp,AC_PosControl_Logging.cpp,AC_CommandModel.cpp,AC_WeatherVane.cpp AC_AutoTune:AC_AutoTune.cpp,AC_AutoTune_FreqResp.cpp,AC_AutoTune_Multi.cpp AP_Motors:AP_Motors_Class.cpp,AP_MotorsMulticopter.cpp,AP_MotorsMatrix.cpp,AP_MotorsMatrix_6DoF_Scripting.cpp,AP_MotorsMatrix_Scripting_Dynamic.cpp,AP_Motors6DOF.cpp,AP_Motors_Thrust_Linearization.cpp,AP_MotorsTri.cpp,AP_MotorsSingle.cpp,AP_MotorsCoax.cpp,AP_MotorsTailsitter.cpp AP_Notify:AP_Notify.cpp,Display.cpp,Display_SSD1306_I2C.cpp,RGBLed.cpp,SerialLED.cpp,NeoPixel.cpp,ToneAlarm.cpp,MMLPlayer.cpp AP_Common:AP_Common.cpp,AP_ExpandingArray.cpp,AP_FWVersion.cpp,ExpandingString.cpp,Location.cpp,c++.cpp,float16.cpp,sorting.cpp,time.cpp AP_RangeFinder:AP_RangeFinder.cpp,AP_RangeFinder_Backend.cpp,AP_RangeFinder_Backend_I2C.cpp,AP_RangeFinder_Params.cpp,AP_RangeFinder_VL53L3CX.cpp AP_Baro:AP_Baro.cpp,AP_Baro_Backend.cpp,AP_Baro_BMP280.cpp,AP_Baro_Logging.cpp,AP_Baro_atmosphere.cpp AP_Compass:AP_Compass.cpp,AP_Compass_Backend.cpp,AP_Compass_BMM150.cpp,AP_Compass_Logging.cpp,AP_Compass_Calibration.cpp,CompassCalibrator.cpp,Compass_PerMotor.cpp AP_InertialSensor:AP_InertialSensor.cpp,AP_InertialSensor_Backend.cpp,AP_InertialSensor_BMI270.cpp,AP_InertialSensor_Logging.cpp,AP_InertialSensor_NONE.cpp,AP_InertialSensor_Params.cpp AP_BattMonitor:AP_BattMonitor.cpp,AP_BattMonitor_Backend.cpp,AP_BattMonitor_INA3221.cpp,AP_BattMonitor_Logging.cpp,AP_BattMonitor_Params.cpp AP_GPS:AP_GPS.cpp,AP_GPS_MAV.cpp,AP_GPS_Params.cpp,AP_GPS_UBLOX.cpp,GPS_Backend.cpp AP_AHRS:AP_AHRS.cpp,AP_AHRS_Backend.cpp,AP_AHRS_DCM.cpp,AP_AHRS_Logging.cpp,AP_AHRS_NavEKF3.cpp,AP_AHRS_View.cpp AP_OpticalFlow:AP_OpticalFlow.cpp,AP_OpticalFlow_Backend.cpp,AP_OpticalFlow_CXOF.cpp,AP_OpticalFlow_MAV.cpp
define HAL_RANGEFINDER_VL53L3CX_XSHUT_DOWN 7
define HAL_RANGEFINDER_VL53L3CX_XSHUT_FORWARD 9
define HAL_RANGEFINDER_VL53L3CX_INT_DOWN 6
define HAL_RANGEFINDER_VL53L3CX_INT_FORWARD 8

# HARDWARE UARTS. UART 0 uses ESP32-S3 USB Serial/JTAG for console/MAVLink.
# UART 1 (SERIAL3) is the black grove connector
#             PORT        RXPIN        TXPIN
ESP32_SERIAL  UART_NUM_0  GPIO_NUM_18  GPIO_NUM_17
ESP32_SERIAL  UART_NUM_1  GPIO_NUM_1   GPIO_NUM_2

define HAL_ESP32_UART0_USB_SERIAL_JTAG 1

# RC Output (r-up, l-down, l-up, r-down (quad X order))

# Display/notify profile:
# M5StampFly uses WS2812C NeoPixel LEDs, a GPIO40 ToneAlarm buzzer, and optional
# Grove SSD1315/SSD1306-compatible OLED display support. SH1106 is disabled so
# the unused display driver is not linked.
# onboard WS2812C RGB LEDs, driven by SerialLED channel 1
define HAL_SERIALLED_ENABLED 1
define HAL_ESP32_SERIALLED_PIN GPIO_NUM_39
define HAL_ESP32_SERIALLED_MAX_LEDS 2
define AP_NOTIFY_NEOPIXEL_MASK 1
define NOTIFY_LED_LEN_DEFAULT 2
define DEFAULT_NTF_LED_TYPES 256
# M5StampFly uses WS2812C NeoPixel LEDs and ToneAlarm only.
define HAL_DISPLAY_ENABLED 1
define AP_NOTIFY_DISPLAY_SSD1306_ENABLED 1
define AP_NOTIFY_DISPLAY_SH1106_ENABLED 0
define AP_NOTIFY_BUZZER_ENABLED 0
define AP_NOTIFY_TOSHIBALED_ENABLED 0
define AP_NOTIFY_NCP5623_ENABLED 0
define AP_NOTIFY_PCA9685_ENABLED 0
define AP_NOTIFY_PROFILED_ENABLED 0
define AP_NOTIFY_SCRIPTING_LED_ENABLED 0
define AP_NOTIFY_LP5562_ENABLED 0
define AP_NOTIFY_IS31FL3195_ENABLED 0
ESP32_RCOUT GPIO_NUM_42
ESP32_RCOUT GPIO_NUM_10
ESP32_RCOUT GPIO_NUM_5
ESP32_RCOUT GPIO_NUM_41

# passive buzzer driven through Q2 by GPIO40
define HAL_ESP32_TONEALARM_PIN GPIO_NUM_40
define HAL_ESP32_TONEALARM_MIN_FREQ_HZ 3200
define HAL_ESP32_TONEALARM_MAX_FREQ_HZ 4800
define AP_NOTIFY_TONEALARM_ENABLED 1

