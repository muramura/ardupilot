# drone specific settings
FRAME_CLASS 1
MOT_PWM_TYPE 3 # brushed motor PWM
RC_SPEED 32000 # as fast as ardupilot supports (more would be nice)
LOG_BACKEND_TYPE 1 # FlashFS logging
ARMING_SKIPCHK 1024 # disable logging check (in the event log rx is not up)
LOG_DISARMED 1
LOG_BITMASK 0 # keep onboard logs small; STATUSTEXT is still logged as MSG
LOG_MAX_FILES 3
LOG_FILE_MB_FREE 0
SCHED_LOOP_RATE 150 # flash won't go faster :(
SCR_ENABLE 1 # enable Lua scripting

# mavlink RC control
FS_THR_ENABLE 0 # not wanted for mavlink control
RC1_MIN 1101 # avoid calibration needed warning
RC_OPTIONS 96 # ignore rpy stick positions during arming, nice for crap controllers

# tuning parameters from mission planner's wizard
ATC_ACC_P_MAX 2002
ATC_ACC_R_MAX 2002
ATC_ACC_Y_MAX 338
ATC_RAT_PIT_FLTD 67
ATC_RAT_PIT_FLTT 67
ATC_RAT_RLL_FLTD 67
ATC_RAT_RLL_FLTT 67
ATC_RAT_YAW_FLTD 0
ATC_RAT_YAW_FLTE 2
ATC_RAT_YAW_FLTT 67
INS_GYRO_FILTER 134
MOT_THST_EXPO 0.45

# battery monitoring settings
BATT_ARM_MAH    0
BATT_ARM_VOLT   0
BATT_CAPACITY   300
BATT_CHANNEL    2
BATT_CRT_MAH    0
BATT_CRT_VOLT   0
BATT_FS_CRT_ACT 0
BATT_FS_LOW_ACT 0
BATT_FS_VOLTSRC 0
BATT_I2C_ADDR   64
BATT_I2C_BUS    0
BATT_LOW_MAH    0
BATT_LOW_TIMER  10
BATT_LOW_VOLT   3.4
BATT_MONITOR    30
BATT_OPTIONS    0
BATT_SERIAL_NUM -1

# RangeFinder settings (Downward VL53L3CX for Altitude, Forward Disabled)
RNGFND1_TYPE    49
RNGFND1_ORIENT  25
RNGFND1_MIN     0.01
RNGFND1_MAX     3.0
RNGFND1_GNDCLR  0.02
RNGFND2_TYPE    0

# Compass settings (BMM150 fixed on PCB)
COMPASS_AUTO_ROT 0
COMPASS_OFFS_MAX 5500
COMPASS_CAL_FIT  64

# EKF3 Height source using downward RangeFinder
EK3_SRC1_POSZ   2
EK3_SRC1_VELZ   0
EK3_RNG_USE_HGT -1
EK3_RNG_M_NSE   0.2
SURFTRAK_MODE   1

